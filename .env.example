# ============================================================
# Personalized Nutrition & Recipe Tracker - Environment Config
# Copy this file to .env.local:
#   cp .env.example .env.local
# ============================================================

# MySQL 8.0 Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DATABASE=nutrition_tracker

# MongoDB 6+ Configuration
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=nutrition_tracker

# JWT Authentication Secret (minimum 32 characters for HMAC SHA-256)
# MANDATORY in production mode. Refuses to start/sign if unset in production.
JWT_SECRET=dev-secret-key-change-in-production-min-32-chars

# Evaluation Mode Configuration (Viva Demonstrations)
# Set to 'true' to allow unauthenticated access to Review Console inspection & demo APIs.
# STRICT CONDITION: Effective ONLY when NODE_ENV=development.
# Production environments (NODE_ENV=production) ALWAYS enforce JWT authentication,
# strictly ignoring this variable.
EVALUATION_MODE=true
